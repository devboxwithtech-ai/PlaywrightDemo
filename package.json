  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.14",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonpath": "^1.1.1"
  }
